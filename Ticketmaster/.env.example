# Environment Variables for Ticketmaster System

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-ticketmaster-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
DJANGO_USE_SQLITE=False
POSTGRES_DB=ticketmaster_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Lock Engine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_sample_ticketmaster_stripe_public_key
STRIPE_SECRET_KEY=sk_test_sample_ticketmaster_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_secret

# Virtual Waiting Room & Surge Settings
WAITING_ROOM_ENABLED=False
WAITING_ROOM_THRESHOLD_ACTIVE_USERS=500
QUEUE_BATCH_RELEASE_SIZE=200
RESERVATION_TTL_SECONDS=600
