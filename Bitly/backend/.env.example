# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
INSTANCE_ID=write-worker-1

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitly
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bitly

# Redis Configuration (Cache & Global Counter)
REDIS_URL=redis://localhost:6379

# Distributed Counter Settings
COUNTER_BATCH_SIZE=1000
COUNTER_KEY=bitly:global_counter

# Cache Settings
CACHE_TTL_SECONDS=86400
ENABLE_IN_MEMORY_FALLBACK=true
