# ==============================================================================
# CloudVault React Frontend Environment Configuration
# ==============================================================================

# API Base URL:
# Use '/api' when using Vite dev server (proxied to http://127.0.0.1:8000 via vite.config.js)
# Or set direct URL e.g. 'http://127.0.0.1:8000/api'
VITE_API_BASE_URL=/api

# Application Display Title
VITE_APP_TITLE=CloudVault - Dropbox System Design

# MinIO / AWS S3 Endpoints (for direct browser PUT uploads and console access)
VITE_MINIO_ENDPOINT=http://127.0.0.1:9000
VITE_MINIO_CONSOLE_URL=http://127.0.0.1:9001
VITE_MINIO_BUCKET_NAME=dropbox-files
