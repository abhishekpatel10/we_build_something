# ==========================================
# Django Application Configuration
# ==========================================
DJANGO_SECRET_KEY=django-insecure-dropbox-system-design-secret-key-change-in-prod-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Database Configuration (PostgreSQL with SQLite Fallback)
# ==========================================
DB_ENGINE=postgres
POSTGRES_DB=dropbox_db
POSTGRES_USER=dropbox_user
POSTGRES_PASSWORD=dropbox_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ==========================================
# MinIO / AWS S3 Configuration
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dropbox-files
MINIO_REGION_NAME=us-east-1
MINIO_USE_SSL=False

# Default chunk size in bytes (5 MB = 5 * 1024 * 1024)
DEFAULT_CHUNK_SIZE_BYTES=5242880
PRESIGNED_URL_EXPIRY_SECONDS=3600
